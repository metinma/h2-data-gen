#Gypsum
#-start
#  1 A0 = parm(1)
#  2 V  = parm(2)
# 10 k25 = 0.0016       # mol m^-2 s^-1 at 25°C (tune; start conservative)
# 20 Ea  = 35e3             # J/mol, apparent activation energy (tune if needed)
# 30 Rg  = 8.3145
# 40 kT  = k25*EXP(Ea/Rg*(1/TK - 1/298.15))
# 50 rate = (A0/V)*(m/m0)^(2/3)*kT*(1 - SR("Gypsum"))
# 60 moles = rate*TIME
# 70 SAVE moles
#-end

#############################################
# 8) Output 
#############################################
# ----------- Output & Graphs  -----------
SELECTED_OUTPUT
 -reset false
 -high_precision true
 -user_punch true
USER_PUNCH
-headings time_d pH Ptot_atm H2_cmol N2_cmol CO2_cmol CH4_cmol \
          H2N2_ratio H2_g_mol N2_g_mol CO2_g_mol CH4_g_mol \
          Ca_mgL Mg_mgL Na_mgL SO4_mgL Alk_HCO3_mgL \
          SI_Calcite Calcite_mol \
          Illite_mol X_SRB_mol X_IRB_mol SR_H2 IR_H2 H2S_g_mol Water_kg

-start

 10 td = TOTAL_TIME/86400.0

 20 nH2  = GAS("Hdg(g)")
 30 nN2  = GAS("Ntg(g)")
 40 nCO2 = GAS("CO2(g)")
 50 nCH4 = GAS("Mtg(g)")
 60 nH2S = GAS("H2S(g)")

 70 ngas = nH2 + nN2 + nCO2 + nCH4 + nH2S

 80 IF (ngas <= 0) THEN ngas = 1e-30

 90 yH2  = 100*nH2/ngas
100 yN2  = 100*nN2/ngas
110 yCO2 = 100*nCO2/ngas
120 yCH4 = 100*nCH4/ngas

130 IF (yN2 > 0) THEN ratio = yH2/yN2
140 IF (yN2 <= 0) THEN ratio = 0

150 Ptot = PR_P("Hdg(g)") + PR_P("Ntg(g)") + \
           PR_P("CO2(g)") + PR_P("Mtg(g)") + PR_P("H2S(g)")

# mol/kgw -> mg/L yaklasik dönüsümleri
160 Ca_mg  = TOT("Ca")*40.078*1000
170 Mg_mg  = TOT("Mg")*24.305*1000
180 Na_mg  = TOT("Na")*22.9898*1000
190 SO4_mg = TOT("S(6)")*96.06*1000

# Toplam alkaliniteyi HCO3 esdegeri olarak yaklasik gösterim
200 Alk_mg = ALK*61.016*1000

210 PUNCH td, -LA("H+"), Ptot, \
           yH2, yN2, yCO2, yCH4, ratio, \
           nH2, nN2, nCO2, nCH4, \
           Ca_mg, Mg_mg, Na_mg, SO4_mg, Alk_mg, \
           SI("Calcite"), KIN("Calcite"), \
           KIN("Illite"), KIN("X_SRB"), KIN("X_IRB"), KIN("SR_H2"), KIN("IR_H2"), nH2S, TOT("water")
-end


END
